# TOUCH GRASS — FastAPI AI Gateway Backend Environment Configuration

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Settings (gemini | mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Alternative (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Request Limits & Timeouts
REQUEST_TIMEOUT_SECONDS=10
MAX_PROMPT_LENGTH=1000

# ElevenLabs Voice Settings (TTS & STT)
# Note: Secret API keys must start with 'sk_'. Do not use Key IDs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_GUARDIAN_VOICE_ID=AZnzlk1XvdvUeBnXmlld
